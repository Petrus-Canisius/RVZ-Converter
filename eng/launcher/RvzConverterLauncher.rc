#include <windows.h>

APP_ICON ICON "src/RvzConverter.App/Assets/App.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "eng/launcher/RvzConverterLauncher.manifest"

1 VERSIONINFO
 FILEVERSION 2,0,1,0
 PRODUCTVERSION 2,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Petrus-Canisius\0"
            VALUE "FileDescription", "RVZ Converter\0"
            VALUE "FileVersion", "2.0.1.0\0"
            VALUE "InternalName", "RVZConverter\0"
            VALUE "LegalCopyright", "Created by Petrus-Canisius\0"
            VALUE "OriginalFilename", "RVZConverter.exe\0"
            VALUE "ProductName", "RVZ Converter\0"
            VALUE "ProductVersion", "2.0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
